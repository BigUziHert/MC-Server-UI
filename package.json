{
  "name": "mc-server-ui",
  "version": "0.1.1",
  "private": true,
  "description": "A local Minecraft server console and management panel",
  "author": "BigUziHert",
  "main": "desktop/main.mjs",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs desktop/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests *.ts *.json *.md *.yaml index.html",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:prepare": "node node_modules/electron/install.js && node desktop/generate-icons.mjs",
    "desktop": "pnpm desktop:prepare && pnpm build && electron .",
    "desktop:pack": "pnpm desktop:prepare && pnpm build && electron-builder --config electron-builder.yml --win --x64 --dir --publish never",
    "desktop:dist": "pnpm desktop:prepare && pnpm build && electron-builder --config electron-builder.yml --win --x64 --publish never",
    "test:desktop": "node desktop/smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tar": "^7.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  }
}
