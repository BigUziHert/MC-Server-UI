# The owner panel binds only to 127.0.0.1. The Vite dev proxy expects port 3001.
# Never expose this owner port through a public proxy or tunnel.
# Configure authenticated remote access in Subusers (separate port 3002 by default).
# Direct remote access uses built-in HTTPS, your public IP, and a forwarded TCP port.
# Share invitation links yourself; no domain or email service is required.
# An existing HTTPS proxy/tunnel remains available in advanced connection options.
PORT=3001
# MC_* and JAVA_PATH initialize the original server only, before servers.json exists.
# After initialization, use the panel's server settings and Add server controls.
MC_SERVER_NAME="The Overworld"
MC_SERVER_ADDRESS=localhost:25565
# Optional: defaults to the existing server.properties port, otherwise 25565.
# MC_PORT=25565
MC_MEMORY_MB=4096
MC_MAX_PLAYERS=20

# To import a server on the first startup, supply its existing directory and JAR.
# You can also create or import a server through the panel's Add server controls.
# MC_SERVER_DIR=C:/Minecraft/my-server
# MC_SERVER_JAR=paper.jar
# JAVA_PATH=C:/Program Files/Java/jdk-21/bin/java.exe
# MC_VERSION=1.21.4
# MC_SOFTWARE=Paper

# Backups, SQLite files, and panel state are stored here, outside MC_SERVER_DIR.
# PANEL_DATA_DIR=C:/Minecraft/panel-data
