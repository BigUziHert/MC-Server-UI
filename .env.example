# The panel binds only to 127.0.0.1. The Vite dev proxy expects port 3001.
PORT=3001
MC_SERVER_NAME="The Overworld"
MC_SERVER_ADDRESS=localhost:25565
MC_MEMORY_MB=4096
MC_MAX_PLAYERS=20

# Leave MC_SERVER_JAR unset for the clearly labelled, simulated demo.
# To run an actual server, supply an existing server directory and JAR within it.
# MC_SERVER_DIR=C:/Minecraft/my-server
# MC_SERVER_JAR=paper.jar
# JAVA_PATH=C:/Program Files/Java/jdk-21/bin/java.exe
# MC_VERSION=1.21.4
# MC_SOFTWARE=Paper

# Backups, SQLite files, and panel state are stored here, outside MC_SERVER_DIR.
# PANEL_DATA_DIR=C:/Minecraft/panel-data
